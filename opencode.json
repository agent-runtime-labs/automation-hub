{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.5-fast",
  "small_model": "openai/gpt-5.5-fast",

  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "low",
        "store": false
      }
    }
  },

  "agent": {
    "plan": {
      "model": "openai/gpt-5.5-fast",
      "reasoningEffort": "medium"
    },

    "build": {
      "model": "openai/gpt-5.5-fast",
      "reasoningEffort": "medium"
    },

    "title": {
      "model": "openai/gpt-5.5-fast",
      "reasoningEffort": "low"
    },

    "compaction": {
      "model": "openai/gpt-5.5-fast",
      "reasoningEffort": "low"
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },

  "instructions": [
    "AGENTS.md"
  ],

  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp" : {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  }
}