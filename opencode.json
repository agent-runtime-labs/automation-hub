{
  "$schema": "https://opencode.ai/config.json",

  "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
  // "model": "openai/gpt-5.4-fast",
  // "small_model": "openai/gpt-5.4-fast",

  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "low",
        "store": false
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },

  "instructions": [
    "AGENTS.md"
  ],

  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp" : {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "candidate-generator": {
      "type": "local",
      "command": [
        "scripts/.venv/bin/python",
        "scripts/fake_candidate_profile.py"
      ],
      "enabled": true
    },
    "document-generator": {
      "type": "local",
      "command": [
        "npx",
        "--yes", "--cache", "/tmp/.npx-cache", "document-generator-mcp@latest"
      ],
      "enabled": true
    },
    "talent-kb": {
      "type": "remote",
      "url": "https://talent-mcp-server-dev-gateway-mdhrvec9is.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp",
       "headers": {
        "Authorization": "Bearer {env:TALENT_KB_MCP_SERVER_BEARER_TOKEN}"
      },
      "enabled": true

    }
   
  },
   "plugin": ["opencode-agent-memory@0.2.0"]
}